{
  "schemaFormat": "bepstudio-schema",
  "schemaFormatVersion": "1.0",
  "key": "four-partner-cover-example",
  "label": "Four project partners cover",
  "version": "1.1.0",
  "description": "A controlled PDF cover with company identity.",
  "ui": {
    "cover": {
      "blocks": [
        "title",
        "project",
        "companies",
        "metadata",
        "image"
      ],
      "title": "Project BIM Execution Plan",
      "imageField": "cover-image",
      "companies": [
        {
          "nameField": "company-name",
          "logoField": "company-logo",
          "source": "automatic",
          "addressLine1Field": "company-address-1",
          "addressLine2Field": "company-address-2",
          "selectionField": "company-selection"
        },
        {
          "nameField": "company-name-2",
          "logoField": "company-logo-2",
          "source": "automatic",
          "addressLine1Field": "company-address-1-2",
          "addressLine2Field": "company-address-2-2",
          "selectionField": "company-selection-2"
        },
        {
          "nameField": "company-name-3",
          "logoField": "company-logo-3",
          "source": "automatic",
          "addressLine1Field": "company-address-1-3",
          "addressLine2Field": "company-address-2-3",
          "selectionField": "company-selection-3"
        },
        {
          "nameField": "company-name-4",
          "logoField": "company-logo-4",
          "source": "automatic",
          "addressLine1Field": "company-address-1-4",
          "addressLine2Field": "company-address-2-4",
          "selectionField": "company-selection-4"
        }
      ],
      "companyCount": 4,
      "backgroundColor": "#0f2b63",
      "showAddresses": true
    }
  },
  "sections": [
    {
      "key": "cover",
      "title": "Cover details",
      "description": "Choose or upload company branding for this document.",
      "fields": [
        {
          "key": "company-selection",
          "label": "Company selection",
          "fieldType": "TEXT",
          "isRequired": false,
          "config": {
            "coverOnly": true,
            "coverInternal": true
          },
          "sortOrder": 1
        },
        {
          "key": "company-name",
          "label": "Company name",
          "fieldType": "TEXT",
          "sortOrder": 2
        },
        {
          "key": "company-address-1",
          "label": "Company address line 1",
          "fieldType": "TEXT",
          "config": {
            "coverOnly": true
          },
          "sortOrder": 3
        },
        {
          "key": "company-address-2",
          "label": "Company address line 2",
          "fieldType": "TEXT",
          "config": {
            "coverOnly": true
          },
          "sortOrder": 4
        },
        {
          "key": "company-logo",
          "label": "Company logo",
          "fieldType": "TEXT",
          "config": {
            "mode": "blob-image-upload"
          },
          "sortOrder": 5
        },
        {
          "key": "company-selection-2",
          "label": "Partner 2 Company selection",
          "fieldType": "TEXT",
          "isRequired": false,
          "config": {
            "coverOnly": true,
            "coverInternal": true
          },
          "sortOrder": 6
        },
        {
          "key": "company-name-2",
          "label": "Partner 2 Company name",
          "fieldType": "TEXT",
          "sortOrder": 7
        },
        {
          "key": "company-address-1-2",
          "label": "Partner 2 Company address line 1",
          "fieldType": "TEXT",
          "config": {
            "coverOnly": true
          },
          "sortOrder": 8
        },
        {
          "key": "company-address-2-2",
          "label": "Partner 2 Company address line 2",
          "fieldType": "TEXT",
          "config": {
            "coverOnly": true
          },
          "sortOrder": 9
        },
        {
          "key": "company-logo-2",
          "label": "Partner 2 Company logo",
          "fieldType": "TEXT",
          "config": {
            "mode": "blob-image-upload"
          },
          "sortOrder": 10
        },
        {
          "key": "company-selection-3",
