          },
          "sortOrder": 11
        },
        {
          "key": "company-name-3",
          "label": "Partner 3 Company name",
          "fieldType": "TEXT",
          "sortOrder": 12
        },
        {
          "key": "company-address-1-3",
          "label": "Partner 3 Company address line 1",
          "fieldType": "TEXT",
          "config": {
            "coverOnly": true
          },
          "sortOrder": 13
        },
        {
          "key": "company-address-2-3",
          "label": "Partner 3 Company address line 2",
          "fieldType": "TEXT",
          "config": {
            "coverOnly": true
          },
          "sortOrder": 14
        },
